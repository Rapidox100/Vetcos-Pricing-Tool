# Caddy reverse proxy for the Vetcos Quote Tool.
# Replace YOUR_DOMAIN with your actual domain (e.g. quotes.vetcos.com) before use.
# Caddy automatically requests and renews a Let's Encrypt HTTPS certificate
# for this domain the first time it starts - no manual certbot steps needed.

YOUR_DOMAIN {
	reverse_proxy localhost:3000
	encode gzip
}
