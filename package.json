{
  "name": "vetcos-quote-tool",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Vetcos Quote Tool - pricing & quotation app for SMS Vetcare Technologies Private Limited",
  "main": "server/src/index.js",
  "scripts": {
    "install:all": "npm install && npm --prefix client install",
    "build": "npm --prefix client run build",
    "start": "node server/src/index.js",
    "dev:server": "node --watch server/src/index.js",
    "dev:client": "npm --prefix client run dev",
    "setup": "npm run install:all && npm run build"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.3.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "jsonwebtoken": "^9.0.2",
    "pdf-lib": "^1.17.1"
  },
  "license": "UNLICENSED"
}
